{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --ignore-scripts",
  "headers": [
    {"source":"/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/livret-adulte.pdf","headers":[{"key":"Content-Type","value":"application/pdf"},{"key":"Content-Disposition","value":"inline; filename=livret-adulte.pdf"}]},
    {"source":"/livret-pediatrique.pdf","headers":[{"key":"Content-Type","value":"application/pdf"},{"key":"Content-Disposition","value":"inline; filename=livret-pediatrique.pdf"}]},
    {"source":"/livret-source.pdf","headers":[{"key":"Content-Type","value":"application/pdf"},{"key":"Content-Disposition","value":"inline; filename=livret-source.pdf"}]}
  ]
}
